<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="vx::Colour">
		<DisplayString>r={(int)r}, g={(int)g}, b={(int)b}, a={(int)a}</DisplayString>
	</Type>
	<Type Name="vx::BodyID">
		<DisplayString>ID={(int)mID}, Idx={mID &amp; 0x00ffffff}, gen={(int)mID >> kBitShiftGen}</DisplayString>
	</Type>
	<Type Name="vx::Float3">
		<DisplayString>{x}, {y}, {z} </DisplayString>
	</Type>
		<Type Name="vx::Vec2">
		<DisplayString>{x}, {y}, L^2={x*x+y*y}</DisplayString>
	</Type>
	<Type Name="vx::Vec3">
		<DisplayString>{mFloats[0]}, {mFloats[1]}, {mFloats[2]}, L^2={mFloats[0]*mFloats[0]+mFloats[1]*mFloats[1]+mFloats[2]*mFloats[2]}</DisplayString>
	</Type>
	<Type Name="vx::Vec4">
		<DisplayString>{mFloats[0]}, {mFloats[1]}, {mFloats[2]}, {mFloats[3]}, L^2={mFloats[0]*mFloats[0]+mFloats[1]*mFloats[1]+mFloats[2]*mFloats[2]+mFloats[3]*mFloats[3]}</DisplayString>
	</Type>
	<Type Name="vx::Mat44">
		<DisplayString>Columns=[{mFloats[0]},{mFloats[1]},{mFloats[2]},{mFloats[3]}] 
							[{mFloats[4]},{mFloats[5]},{mFloats[6]},{mFloats[7]}]
							[{mFloats[8]},{mFloats[9]},{mFloats[10]},{mFloats[11]}]
							[{mFloats[12]},{mFloats[13]},{mFloats[14]},{mFloats[15]}]
		</DisplayString>
		<Expand>
			<Synthetic Name="[Row 0]">
				<DisplayString>{mCol[0].mFloats[0]}, {mCol[1].mFloats[0]}, {mCol[2].mFloats[0]}, {mCol[3].mFloats[0]}</DisplayString>
			</Synthetic>
			<Synthetic Name="[Row 1]">
				<DisplayString>{mCol[0].mFloats[1]}, {mCol[1].mFloats[1]}, {mCol[2].mFloats[1]}, {mCol[3].mFloats[1]}</DisplayString>
			</Synthetic>
			<Synthetic Name="[Row 2]">
				<DisplayString>{mCol[0].mFloats[2]}, {mCol[1].mFloats[2]}, {mCol[2].mFloats[2]}, {mCol[3].mFloats[2]}</DisplayString>
			</Synthetic>
			<Synthetic Name="[Row 3]">
				<DisplayString>{mCol[0].mFloats[3]}, {mCol[1].mFloats[3]}, {mCol[2].mFloats[3]}, {mCol[3].mFloats[3]}</DisplayString>
			</Synthetic>
			<Synthetic Name="[Basis Determinant]">
				<DisplayString>
					{mFloats[0] * (mFloats[5] * mFloats[10] - mFloats[6] * mFloats[9]) -
					mFloats[4] * (mFloats[1] * mFloats[10] - mFloats[2] * mFloats[9]) +
					mFloats[8] * (mFloats[1] * mFloats[6] - mFloats[2] * mFloats[5])}
				</DisplayString>
			</Synthetic>

			<Synthetic Name="[Basis Length^2]">
				<Expand>
					<Synthetic Name="[X]">
						<DisplayString>{mCol[0].mFloats[0]*mCol[0].mFloats[0]+mCol[0].mFloats[1]*mCol[0].mFloats[1]+mCol[0].mFloats[2]*mCol[0].mFloats[2]+mCol[0].mFloats[3]*mCol[0].mFloats[3]}</DisplayString>
					</Synthetic>
					<Synthetic Name="[Y]">
						<DisplayString>{mCol[1].mFloats[0]*mCol[1].mFloats[0]+mCol[1].mFloats[1]*mCol[1].mFloats[1]+mCol[1].mFloats[2]*mCol[1].mFloats[2]+mCol[1].mFloats[3]*mCol[1].mFloats[3]}</DisplayString>
					</Synthetic>
					<Synthetic Name="[Z]">
						<DisplayString>{mCol[2].mFloats[0]*mCol[2].mFloats[0]+mCol[2].mFloats[1]*mCol[2].mFloats[1]+mCol[2].mFloats[2]*mCol[2].mFloats[2]+mCol[2].mFloats[3]*mCol[2].mFloats[3]}</DisplayString>
					</Synthetic>
				</Expand>
			</Synthetic>
		
		</Expand>
	</Type>

	<Type Name="vx::AABB">
		<DisplayString>min=({mMin}), max=({mMax})</DisplayString>
	</Type>



</AutoVisualizer>